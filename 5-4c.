#include <stdio.h>
int main(void)
{
    int n;
    scanf("%d", &n);
    int half = (n + 1) / 2;     
    for (int i = 0; i < half; i++) {
        for (int j = 0; j < half - 1 - i; j++)
            printf("  ");              
        for (int j = 0; j < 2 * i + 1; j++)
            printf("* ");              
        printf("\n");
    }
    for (int i = half - 2; i >= 0; i--) {
        for (int j = 0; j < half - 1 - i; j++)
            printf("  ");
        for (int j = 0; j < 2 * i + 1; j++)
            printf("* ");
        printf("\n");
    }

    return 0;
}
