#include <stdio.h>

int main(void)
{
    int n, g, s, b;          

    for (n = 100; n <= 999; n++)   
    {
        g = n % 10;            
        s = n / 10 % 10;       
        b = n / 100;           
        if (g*g*g + s*s*s + b*b*b == n)   
            printf("%5d", n);  
    }
    printf("\n");           
    return 0;
}
