#include <stdio.h>
int main(void)
{
    int m, i, j, count = 0;
    scanf("%d", &m);
    for (i = m - 1; i >= 2 && count < 10; i--)  
    {
        int flag = 1;              
        for (j = 2; j * j <= i; j++) 
        {
            if (i % j == 0)          
            {
                flag = 0;
                break;            
            }
        }
        if (flag)             
        {
            printf("%6d", i);
            count++;
        }
    }
    printf("\n");
    return 0;
}
